,"codigo_fonte":"PROVA-QDX-CRFDF-2026-ANALISTA-I-ADVOGADO-401-116","anulada":false,"possui_imagem":false,"descricao_imagem":"","imagem":""},{"id":"prova-qdx-crfdf-2026-analista-i-advogado-401-117","codigo":"PROVA-QDX-CRFDF-2026-ANALISTA-I-ADVOGADO-401-117","numero":117,"numero_original":117,"bloco":"Conhecimentos Específicos","disciplina":"Analista I — Advogado","assunto":"","subassunto":"","texto_base":"","enunciado":"Ao receber o recurso de apelação contra sentença de mérito pela improcedência da ação, o relator poderá decidir monocraticamente, negando provimento ao recurso quando o mesmo for contrário à súmula do próprio tribunal. No que diz respeito aos recursos no processo trabalhista, julgue os itens a seguir.","alternativas":{"Certo":"Certo","Errado":"Errado"},"gabarito":"Certo","comentario":"Comentário não disponível no Banco Mestre; publicação excepcional sem revisão editorial ordinária.","comentarios_alternativas":{"A":"","B":"","C":"","D":"","E":""},"fundamento":"","pegadinha":"","observacoes":"","formato_questao":"Certo / Errado","pagina_pdf":"8","fonte_oficial":"https://app.notion.com/p/PROVA-QDX-CRFDF-2026-ANALISTA-I-ADVOGADO-401-117-3adcf5a2673181409f0deff1e315fd7c","fonte_consolidada":"https://app.notion.com/p/PROVA-QDX-CRFDF-2026-ANALISTA-I-ADVOGADO-401-117-3adcf5a2673181409f0deff1e315fd7c","auditoria":"Publicação excepcional autorizada em 01/08/2026","notion_url":"https://app.notion.com/p/PROVA-QDX-CRFDF-2026-ANALISTA-I-ADVOGADO-401-117-3adcf5a2673181409f0deff1e315fd7c","codigo_fonte":"PROVA-QDX-CRFDF-2026-ANALISTA-I-ADVOGADO-401-117","anulada":false,"possui_imagem":false,"descricao_imagem":"","imagem":""},{"id":"prova-qdx-crfdf-2026-analista-i-advogado-401-118","codigo":"PROVA-QDX-CRFDF-2026-ANALISTA-I-ADVOGADO-401-118","numero":118,"numero_original":118,"bloco":"Conhecimentos Específicos","disciplina":"Analista I — Advogado","assunto":"","subassunto":"","texto_base":"","enunciado":"Cabe agravo de petição de despacho que denega a interposição de r