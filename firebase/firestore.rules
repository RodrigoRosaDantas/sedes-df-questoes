rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isSedesAdmin() {
      return signedIn() && request.auth.token.sedesAdmin == true;
    }

    // O projeto Firebase físico é compartilhado, mas todos os dados pessoais
    // desta plataforma (e do legado compatível) permanecem isolados pelo UID.
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isSedesAdmin();

      match /{document=**} {
        allow read, write: if isOwner(userId) || isSedesAdmin();
      }
    }

    // Qualquer caminho fora da árvore autenticada de usuários fica negado
    // por padrão neste contrato auditável.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
